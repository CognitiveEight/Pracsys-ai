# The image needs only app/ and requirements.lock.txt (see Dockerfile).
# Everything else stays out of the build context.

# Credentials and secrets — never send these to the Docker daemon.
.env
.env.*
!env.example
*.pem
*.key
bns-ai-*.json
gcp-*.json
*-service-account*.json
*-serviceaccount*.json
google-application-credentials.json

# Version control, tooling, caches
.git/
.gitignore
.claude/
.vscode/
.idea/
.cursor/
.codex/
**/__pycache__/
**/*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
env/
venv/
.venv/
ENV/

# Runtime output and local data
logs/
data/
*.log
*.db
*.sqlite

# Not part of the service
keel/
tests/
docs/
scripts/
verify_*.py
masterLaws*.json
my_case.txt
*.docx
*.md
Makefile
docker-compose.yml
dev.sh
run.sh
pytest.ini
requirements-dev.txt
