none;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;shape=mxgraph.aws4.data_stream;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="408" y="360" width="44" height="44" as="geometry"/></mxCell><mxCell id="lay-45" value="Socket.IO client" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#1E1E1E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontSize=9;" vertex="1" parent="1"><mxGeometry x="350" y="410" width="160" height="18" as="geometry"/></mxCell><mxCell id="lay-46" value="python-socketio, outbound wss, HMAC v1" style="text;html=1;whiteSpace=wrap;fontColor=#BBBBBB;fontSize=9;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="340" y="430" width="180" height="30" as="geometry"/></mxCell><mxCell id="lay-47" value="" style="html=1;outlineConnect=0;dashed=0;strokeColor=none;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;shape=mxgraph.aws4.rule;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="688" y="360" width="44" height="44" as="geometry"/></mxCell><mxCell id="lay-48" value="Event router" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#1E1E1E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontSize=9;" vertex="1" parent="1"><mxGeometry x="630" y="410" width="160" height="18" as="geometry"/></mxCell><mxCell id="lay-49" value="SocketEventHandler + per-feature mixins" style="text;html=1;whiteSpace=wrap;fontColor=#BBBBBB;fontSize=9;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="620" y="430" width="180" height="30" as="geometry"/></mxCell><mxCell id="lay-50" value="" style="html=1;outlineConnect=0;dashed=0;strokeColor=none;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;shape=mxgraph.aws4.bucket;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="968" y="360" width="44" height="44" as="geometry"/></mxCell><mxCell id="lay-51" value="File fetch" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#1E1E1E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontSize=9;" vertex="1" parent="1"><mxGeometry x="910" y="410" width="160" height="18" as="geometry"/></mxCell><mxCell id="lay-52" value="evidence via GCS / signed URLs" style="text;html=1;whiteSpace=wrap;fontColor=#BBBBBB;fontSize=9;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="900" y="430" width="180" height="30" as="geometry"/></mxCell><mxCell id="lay-53" value="events / payloads" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=5;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontSize=8;labelBackgroundColor=#1E1E1E;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="180" y="382" as="sourcePoint"/><mxPoint x="400" y="382" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lay-54" value="dispatch" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=5;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontSize=8;labelBackgroundColor=#1E1E1E;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="460" y="382" as="sourcePoint"/><mxPoint x="680" y="382" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lay-55" value="download" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=5;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontSize=8;labelBackgroundColor=#1E1E1E;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="740" y="382" as="sourcePoint"/><mxPoint x="960" y="382" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lay-56" value="role-gated work" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=5;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontSize=8;labelBackgroundColor=#1E1E1E;dashed=1;dashPattern=2 3;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="590" y="530" as="sourcePoint"/><mxPoint x="590" y="580" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lay-57" value="Domain Layer" style="rounded=0;html=1;whiteSpace=wrap;fillColor=none;fontColor=#FFFFFF;strokeColor=#FFFFFF;fontSize=10;fontStyle=1;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGe