<mxfile host="app.diagrams.net" type="device"><diagram name="Layered system architecture" id="layered-1"><mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3480" pageHeight="3290" background="#1E1E1E" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lay-1" value="SimplerToday AI service: layered system architecture (current)" style="text;html=1;whiteSpace=wrap;fontColor=#FFFFFF;fontSize=26;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1200" y="56" width="1500" height="40" as="geometry"/></mxCell><mxCell id="lay-2" value="What runs today, by layer. A Python asyncio Socket.IO &lt;b&gt;client&lt;/b&gt;: it dials out to the application backend, receives workspace and chat events, runs the agents and emits panel and chat payloads back. It exposes no HTTP API." style="text;html=1;whiteSpace=wrap;fontColor=#BBBBBB;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1200" y="98" width="1500" height="60" as="geometry"/></mxCell><mxCell id="lay-3" value="Key" style="rounded=0;html=1;whiteSpace=wrap;fillColor=none;fontColor=#FFFFFF;strokeColor=#FFFFFF;fontSize=10;fontStyle=1;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1200" y="170" width="160" height="18" as="geometry"/></mxCell><mxCell id="lay-4" value="" style="rounded=0;html=1;whiteSpace=wrap;fillColor=none;fontColor=#FFFFFF;strokeColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1200" y="188" width="1100" height="332" as="geometry"/></mxCell><mxCell id="lay-5" value="Runs in this service today" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#1E1E1E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1220" y="205" width="300" height="20" as="geometry"/></mxCell><mxCell id="lay-6" value="External system (not in this repo)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#1E1E1E;strokeColor=#F2A900;fontColor=#F2A900;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1220" y="235" width="300" height="20" as="geometry"/></mxCell><mxCell id="lay-7" value="Optional, provisioned but unused, or not set up" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#1E1E1E;strokeColor=#8A8A8A;fontColor=#8A8A8A;fontSize=9;dashed=1;" vertex="1" parent="1"><mxGeometry x="1220" y="265" width="300" height="20" as="geometry"/></mxCell><mxCell id="lay-8" value="Gate: nothing downstream runs without it" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#1E1E1E;strokeColor=#E06666;fontColor=#FFFFFF;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1220" y="295" width="300" height="20" as="geometry"/></mxCell><mxCell id="lay-9" value="" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=5;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontSize=8;labelBackgroundColor=#1E1E1E;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="1560" y="215" as="sourcePoint"/><mxPoint x="1660" y="215" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lay-10" value="Call or data flow inside a layer" style="text;html=1;whiteSpace=wrap;fontColor=#BBBBBB;fontSize=9;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1670" y="207" width="300" height="20" as="geometry"/></mxCell><mxCell id="lay-11" value="" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=5;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontSize=8;labelBackgroundColor=#1E1E1E;dashed=1;dashPattern=2 3;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="1560" y="245" as="sourcePoint"/><mxPoint x="1660" y="245" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lay-12" value="Flow between layers" style="text;html=1;whiteSpace=wrap;fontColor=#BBBBBB;fontSize=9;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1670" y="237" width="300" height="20" as="geometry"/></mxCell><mxCell id="lay-13" value="" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=5;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontSize=8;labelBackgroundColor=#1E1E1E;dashed=1;strokeColor=#8A8A8A;fontColor=#8A8A8A;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="1560" y="275" as="sourcePoint"/><mxPoint x="1660" y="275" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lay-14" value="Optional flow" style="text;html=1;whiteSpace=wrap;fontColor=#BBBBBB;fontSize=9;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1670" y="267" width="300" height="20" as="geometry"/></mxCell><mxCell id="lay-15" value="" style="html=1;endArrow=none;dashed=1;dashPattern=2 3;strokeColor=#FFFFFF;" edge="1" parent="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="1560" y="305" as="sourcePoint"/><mxPoint x="1620" y="305" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lay-16" value="Agent uses tool" style="text;html=1;whiteSpace=wrap;fontColor=#BBBBBB;fontSize=9;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1670" y="297" width="300" height="20" as="geometry"/></mxCell><mxCell id="lay-17" value="&lt;b style='color:#fff'&gt;How to read it.&lt;/b&gt; Top to bottom: who uses it (Presentation), how events arrive (Application), the agents, tools and data that do the work (Domain), then the platform underneath: model providers and cloud APIs (Infrastructure), the socket edge, security controls, delivery, logging and tests.&lt;br&gt;&lt;br&gt;Every box maps to code: captions name the module or the &lt;i&gt;featureType&lt;/i&gt; it emits. Detailed views (C4 context, containers, components, sequences, deployment) are in &lt;b style='color:#fff'&gt;docs/system-architecture.drawio&lt;/b&gt;." style="text;html=1;whiteSpace=wrap;fontColor=#BBBBBB;fontSize=9;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1220" y="335" width="1060" height="170" as="geometry"/></mxCell><mxCell id="lay-18" value="Not in the current system (future-state only)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=none;fontColor=#FFFFFF;strokeColor=#8A8A8A;fontColor=#8A8A8A;fontSize=10;fontStyle=1;align=left;spacingLeft=4;dashed=1;" vertex="1" parent="1"><mxGeometry x="2340" y="170" width="303" height="18" as="geometry"/></mxCell><mxCell id="lay-19" value="" style="rounded=0;html=1;whiteSpace=wrap;fillColor=none;fontColor=#FFFFFF;strokeColor=#8A8A8A;dashed=1;" vertex="1" parent="1"><mxGeometry x="2340" y="188" width="1100" height="332" as="geometry"/></mxCell><mxCell id="lay-20" value="These appear in the future-state diagram but do not exist in the code today, so they are left out here:&lt;br&gt;&lt;br&gt;&amp;bull; HTTP API layer: Nginx, rate limiter, API gateway, API auth (the service only dials out)&lt;br&gt;&amp;bull; MongoDB and a prompt hub (prompts are code in &lt;i&gt;app/prompts/&lt;/i&gt;)&lt;br&gt;&amp;bull; Message queue (SQS): background work is in-process &lt;i&gt;asyncio&lt;/i&gt; tasks&lt;br&gt;&amp;bull; Redis as memory: it is in docker-compose, but no code uses it&lt;br&gt;&amp;bull; OAuth / JWT / RBAC: auth is an HMAC-signed socket handshake; access is the backend's edit/view roster&lt;br&gt;&amp;bull; Kubernetes, Graylog, Zabbix, LLM tracer: production runs on GCP VMs; no orchestrator or external monitoring is set up&lt;br&gt;&amp;bull; Translation service and voice agent; Postman / QA test suites&lt;br&gt;&amp;bull; CI pipeline (GitHub Actions): planned, not set up" style="text;html=1;whiteSpace=wrap;fontColor=#BBBBBB;fontSize=9;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="2360" y="205" width="1060" height="300" as="geometry"/></mxCell><mxCell id="lay-21" value="Presentation Layer (application frontend, outside this repo)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=none;fontColor=#FFFFFF;strokeColor=#FFFFFF;fontSize=10;fontStyle=1;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="396" height="18" as="geometry"/></mxCell><mxCell id="lay-22" value="" style="rounded=0;html=1;whiteSpace=wrap;fillColor=none;fontColor=#FFFFFF;strokeColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="78" width="1100" height="192" as="geometry"/></mxCell><mxCell id="lay-23" value="" style="html=1;outlineConnect=0;dashed=0;strokeColor=none;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;shape=mxgraph.aws4.chat;fillColor=#F2A900;" vertex="1" parent="1"><mxGeometry x="128" y="100" width="44" height="44" as="geometry"/></mxCell><mxCell id="lay-24" value="Chat" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#1E1E1E;strokeColor=#F2A900;fontColor=#F2A900;fontSize=9;" vertex="1" parent="1"><mxGeometry x="75" y="150" width="150" height="18" as="geometry"/></mxCell><mxCell id="lay-25" value="questions, with citations" style="text;html=1;whiteSpace=wrap;fontColor=#BBBBBB;fontSize=9;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="65" y="170" width="170" height="30" as="geometry"/></mxCell><mxCell id="lay-26" value="" style="html=1;outlineConnect=0;dashed=0;strokeColor=none;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;shape=mxgraph.aws4.client;fillColor=#F2A900;" vertex="1" parent="1"><mxGeometry x="338" y="100" width="44" height="44" as="geometry"/></mxCell><mxCell id="lay-27" value="Analysis panels" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#1E1E1E;strokeColor=#F2A900;fontColor=#F2A900;fontSize=9;" vertex="1" parent="1"><mxGeometry x="285" y="150" width="150" height="18" as="geometry"/></mxCell><mxCell id="lay-28" value="7 panels per case" style="text;html=1;whiteSpace=wrap;fontColor=#BBBBBB;fontSize=9;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="275" y="170" width="170" height="30" as="geometry"/></mxCell><mxCell id="lay-29" value="" style="html=1;outlineConnect=0;dashed=0;strokeColor=none;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;shape=mxgraph.aws4.documents;fillColor=#F2A900;" vertex="1" parent="1"><mxGeometry x="548" y="100" width="44" height="44" as="geometry"/></mxCell><mxCell id="lay-30" value="Supporting material" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#1E1E1E;strokeColor=#F2A900;fontColor=#F2A900;fontSize=9;" vertex="1" parent="1"><mxGeometry x="495" y="150" width="150" height="18" as="geometry"/></mxCell><mxCell id="lay-31" value="upload, reload, version restore" style="text;html=1;whiteSpace=wrap;fontColor=#BBBBBB;fontSize=9;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="485" y="170" width="170" height="30" as="geometry"/></mxCell><mxCell id="lay-32" value="" style="html=1;outlineConnect=0;dashed=0;strokeColor=none;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;shape=mxgraph.aws4.multimedia;fillColor=#F2A900;" vertex="1" parent="1"><mxGeometry x="758" y="100" width="44" height="44" as="geometry"/></mxCell><mxCell id="lay-33" value="Audio evidence" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#1E1E1E;strokeColor=#F2A900;fontColor=#F2A900;fontSize=9;" vertex="1" parent="1"><mxGeometry x="705" y="150" width="150" height="18" as="geometry"/></mxCell><mxCell id="lay-34" value="calls and recordings" style="text;html=1;whiteSpace=wrap;fontColor=#BBBBBB;fontSize=9;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="695" y="170" width="170" height="30" as="geometry"/></mxCell><mxCell id="lay-35" value="" style="html=1;outlineConnect=0;dashed=0;strokeColor=none;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;shape=mxgraph.aws4.document;fillColor=#F2A900;" vertex="1" parent="1"><mxGeometry x="968" y="100" width="44" height="44" as="geometry"/></mxCell><mxCell id="lay-36" value="Drafting assistant" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#1E1E1E;strokeColor=#F2A900;fontColor=#F2A900;fontSize=9;" vertex="1" parent="1"><mxGeometry x="915" y="150" width="150" height="18" as="geometry"/></mxCell><mxCell id="lay-37" value="suggested drafts, DOCX export" style="text;html=1;whiteSpace=wrap;fo