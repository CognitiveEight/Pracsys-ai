ryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="851364-6" target="851364-19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="851364-23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;dashed=1;dashPattern=2 4;strokeColor=#999999;exitX=1;exitY=0.13;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="851364-18" target="851364-19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="851364-24" value="[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;dashed=1;dashPattern=2 4;strokeColor=#999999;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="851364-19" target="851364-20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="851364-25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;exitX=1;exitY=0.78;exitDx=0;exitDy=0;entryX=0;entryY=0.29;entryDx=0;entryDy=0;" edge="1" parent="1" source="851364-10" target="851364-20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="851364-26" value="Cost tracking (app/ai/usage.py, app/ai/pricing.py): price and totalPrice are the whole bill" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="1820" height="270" as="geometry"/></mxCell><mxCell id="851364-27" value="&lt;b&gt;record_* at the lowest call site&lt;/b&gt;&lt;br&gt;record_usage (tokens, model=)&lt;br&gt;record_ocr_units (Vision)&lt;br&gt;record_stt_seconds (Speech)&lt;br&gt;record_search_queries (Vertex)&lt;br&gt;record_grounding_requests&lt;br&gt;record_embed_tokens (estimate)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#000000;align=left;" vertex="1" parent="1"><mxGeometry x="60" y="670" width="330" height="190" as="geometry"/></mxCell><mxCell id="851364-28" value="&lt;b&gt;UsageAccumulator scope&lt;/b&gt;&lt;br&gt;contextvars, opened by capture_usage() / @meter_usage; spawned tasks inherit it. Cost with no workspace and no scope warns once per kind" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#000000;align=left;" vertex="1" parent="1"><mxGeometry x="430" y="670" width="330" height="190" as="geometry"/></mxCell><mxCell id="851364-29" value="&lt;b&gt;Workspace ledger&lt;/b&gt;&lt;br&gt;Charged to the workspace bound in the logging context; drain_for_emit returns spend since the last emit, so background work is still billed" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#000000;align=left;" vertex="1" parent="1"><mxGeometry x="800" y="670" width="330" height="190" as="geometry"/></mxCell><mxCell id="851364-30" value="&lt;b&gt;Emit metadata&lt;/b&gt;&lt;br&gt;usage, price, totalPrice, per-source *Price, servicePrice / totalServicePrice; running total in token_usage (WORKSPACE_META cache)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#000000;align=left;" vertex="1" parent="1"><mxGeometry x="1170" y="670" width="330" height="190" as="geometry"/></mxCell><mxCell id="851364-31" value="&lt;b&gt;scripts/reconcile_gate0_spend.py&lt;/b&gt;&lt;br&gt;Reconciles the case ledger with gate0 spend. Rates are env-overridable; free tiers not modelled (upper bound)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#FFFFFF;strokeColor=#438DD5;fontColor=#1A1A1A;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1540" y="670" width="300" height="190" as="geometry"/></mxCell><mxCell id="851364-32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;" edge="1" parent="1" source="851364-27" target="851364-28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="851364-33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;" edge="1" parent="1" source="851364-28" target="851364-29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="851364-34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;" edge="1" parent="1" source="851364-29" target="851364-30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="851364-35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;dashed=1;dashPattern=2 4;strokeColor=#999999;" edge="1" parent="1" source="851364-30" target="851364-31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="851364-36" value="&lt;b&gt;Rules&lt;/b&gt;: never import a provider SDK outside llm/providers · adapters only translate · never read a generate result without is_generation_error() · an embedding provider / model / dimension change is a new collection · new model call paths must go through the router so gate0 applies. Coverage: tests/test_llm_router.py, test_llm_providers.py, test_usage_ledger.py; live billed check: scripts/smoke_llm_providers.py. Detail: docs/MODEL_PORTABILITY.md." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#000000;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="920" width="1820" height="60" as="geometry"/></mxCell><mxCell id="851364-37" value="&lt;b&gt;Key&lt;/b&gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="1024" width="60" height="24" as="geometry"/></mxCell><mxCell id="851364-38" value="&lt;font style='font-size:10px'&gt;Inbound event / trigger&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#000000;align=left;" vertex="1" parent="1"><mxGeometry x="90" y="1020" width="158" height="30" as="geometry"/></mxCell><mxCell id="851364-39" value="&lt;font style='font-size:10px'&gt;Processing step&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#000000;align=left;" vertex="1" parent="1"><mxGeometry x="258" y="1020" width="158" height="30" as="geometry"/></mxCell><mxCell id="851364-40" value="&lt;font style='font-size:10px'&gt;Control / guard&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#000000;align=left;" vertex="1" parent="1"><mxGeometry x="426" y="1020" width="158" height="30" as="geometry"/></mxCell><mxCell id="851364-41" value="&lt;font style='font-size:10px'&gt;Output / emit&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#000000;align=left;" vertex="1" parent="1"><mxGeometry x="594" y="1020" width="158" height="30" as="geometry"/></mxCell><mxCell id="851364-42" value="&lt;font style='font-size:10px'&gt;Component&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="762" y="1020" width="158" height="30" as="geometry"/></mxCell><mxCell id="851364-43" value="&lt;font style='font-size:10px'&gt;Optional&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#FFFFFF;strokeColor=#438DD5;fontColor=#1A1A1A;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="930" y="1020" width="158" height="30" as="geometry"/></mxCell><mxCell id="851364-44" value="&lt;font style='font-size:10px'&gt;Data store&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=5;fontSize=11;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;spacing=4;" vertex="1" parent="1"><mxGeometry x="1098" y="1020" width="158" height="30" as="geometry"/></mxCell><mxCell id="851364-45" value="&lt;font style='font-size:10px'&gt;External system&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1266" y="1020" width="158" height="30" as="geometry"/></mxCell><mxCell id="851364-46" value="&lt;font style='font-size:10px'&gt;Rule / note&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#000000;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1434" y="1020" width="158" height="30" as="geometry"/></mxCell><mxCell id="851364-47" value="SimplerToday AI service · C4 model notation · reflects branch feature/SIM-9-claude-structure at commit 7940542 (2026-10-14) · source of truth: CLAUDE.md and docs/architecture.md · page: 8. Model routing, governance and cost" style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="1066" width="1840" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="588027957" name="9. Data, state and erasure"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1080" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="27957-1" value="9 · Data stores, state and compliance erasure" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="16" width="1840" height="34" as="geometry"/></mxCell><mxCell id="27957-2" value="Where data lives and how a workspace deletion reaches every copy. workspace_deleted is a compliance deletion, not a cache eviction." style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="52" width="1840" height="40" as="geometry"/></mxCell><mxCell id="27957-3" value="Where data lives" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="900" height="520" as="geometry"/></mxCell><mxCell id="27957-4" value="&lt;b&gt;In-memory per-workspace state&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;[attributes of SocketEventHandler]&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Dozens of dicts: payload caches, pending deliveries, run epochs, edited missing info … keyed by workspace id or '&amp;lt;workspace_id&amp;gt;:…'; chat caches via _chat_workspace_index&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="420" height="150" as="geometry"/></mxCell><mxCell id="27957-5" value="&lt;b&gt;Module-level state&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;[workspace/participants.py, custom_instructions.py]&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Sharing roster (personal data) and custom instructions; NOT reached by the __dict__ sweep, cleared explicitly&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="500" y="150" width="420" height="150" as="geometry"/></mxCell><mxCell id="27957-6" value="&lt;b&gt;&amp;lt;collection&amp;gt;&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;[Qdrant, cache points]&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Role, WORKSPACE_META (token_usage), PARTICIPANTS, EDITED_MISSING_INFO, REMOVED_DOCUMENTS, PENDING_FEATURE_DELIVERY …&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fontSize=11;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;spacing=4;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="270" height="170" as="geometry"/></mxCell><mxCell id="27957-7" value="&lt;b&gt;&amp;lt;collection&amp;gt;_evidence_v1&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;[Qdrant, dense + sparse]&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Redacted chunks with page, offsets, heading, sheet rows; deterministic point ids&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fontSize=11;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;spacing=4;" vertex="1" parent="1"><mxGeometry x="350" y="330" width="270" height="170" as="geometry"/></mxCell><mxCell id="27957-8" value="&lt;b&gt;&amp;lt;collection&amp;gt;_tables_v1&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;[Qdrant, no vectors]&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Spreadsheet rows for exact computation; manifest written last&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fontSize=11;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;spacing=4;" vertex="1" parent="1"><mxGeometry x="640" y="330" width="280" height="170" as="geometry"/></mxCell><mxCell id="27957-9" value="&lt;b&gt;Neo4j&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;[optional]&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Facts with chunk_id + page&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fontSize=11;fillColor=#FFFFFF;strokeColor=#438DD5;fontColor=#1A1A1A;dashed=1;dashPattern=6 4;spacing=4;" vertex="1" parent="1"><mxGeometry x="60" y="520" width="270" height="100" as="geometry"/></mxCell><mxCell id="27957-10" value="&lt;b&gt;Local disk&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;[data/workspaces]&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Saved workspace files&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fontSize=11;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;spacing=4;" vertex="1" parent="1"><mxGeometry x="350" y="520" width="270" height="100" as="geometry"/></mxCell><mxCell id="27957-11" value="&lt;b&gt;Logs&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;[logs/]&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;No payloads, document text, names or URLs&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fontSize=11;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;spacing=4;" vertex="1" parent="1"><mxGeometry x="640" y="520" width="280" height="100" as="geometry"/></mxCell><mxCell id="27957-12" value="Writes through; hydrated on cold start" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;exitX=0.37;exitY=1;exitDx=0;exitDy=0;entryX=0.574;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="27957-4" target="27957-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="27957-13" value="Workspace purge (handlers/workspace_purge.py)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="980" y="110" width="880" height="520" as="geometry"/></mxCell><mxCell id="27957-14" value="&lt;b&gt;0 · Receive&lt;/b&gt; workspace_deleted with absolute purgeAfter (never recomputed from purgeAfterDays); re-sends under the same requestId expected" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#000000;align=left;" vertex="1" parent="1"><mxGeometry x="1000" y="150" width="840" height="66" as="geometry"/></mxCell><mxCell id="27957-15" value="&lt;b&gt;1 · Wait&lt;/b&gt; until purgeAfter. Revoked by live traffic: created, sync, version_restore, transferred, reload, resume, missing-info edit" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#000000;align=left;" vertex="1" parent="1"><mxGeometry x="1000" y="228" width="840" height="66" as="geometry"/></mxCell><mxCell id="27957-16" value="" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;" edge="1" parent="1" source="27957-14" target="27957-15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="27957-17" value="&lt;b&gt;2 · Block persistence first&lt;/b&gt; (block_workspace_persistence): an in-flight fire-and-forget upsert cannot recreate a cache point" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#000000;align=left;" vertex="1" parent="1"><mxGeometry x="1000" y="306" width="840" height="66" as="geometry"/></mxCell><mxCell id="27957-18" value="" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;" edge="1" parent="1" source="27957-15" target="27957-17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="27957-19" value="&lt;b&gt;3 · Clear memory&lt;/b&gt;: sweep self.__dict__ for the workspace keys, chat caches via the chat index, participants and custom instructions" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#000000;align=left;" vertex="1" parent="1"><mxGeometry x="1000" y="384" width="840" height="66" as="geometry"/></mxCell><mxCell id="27957-20" value="" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;" edge="1" parent="1" source="27957-17" target="27957-19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="27957-21" value="&lt;b&gt;4 · Delete stores&lt;/b&gt;: delete_workspace → state, evidence, tables and (hook) graph; then disk" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#000000;align=left;" vertex="1" parent="1"><mxGeometry x="1000" y="462" width="840" height="66" as="geometry"/></mxCell><mxCell id="27957-22" value="" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;" edge="1" parent="1" source="27957-19" target="27957-21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="27957-23" value="&lt;b&gt;5 · On failure&lt;/b&gt;: retry with backoff; escalate logger.critical + workspace_purge_failed audit event. A failed graph clear raises so it retries" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#000000;align=left;" vertex="1" parent="1"><mxGeometry x="1000" y="540" width="840" height="66" as="geometry"/></mxCell><mxCell id="27957-24" value="" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;" edge="1" parent="1" source="27957-21" target="27957-23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="27957-25" value="Other deletion and change paths" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="670" width="1820" height="230" as="geometry"/></mxCell><mxCell id="27957-26" value="&lt;b&gt;Document removed&lt;/b&gt;&lt;br&gt;delete_documents (evidence + tables + graph) → _prune_document_assessments → REMOVED_DOCUMENTS ledger → REMOVED EVIDENCE prompt block + deterministic missingInfo gap" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#000000;align=left;" vertex="1" parent="1"><mxGeometry x="60" y="720" width="420" height="150" as="geometry"/></mxCell><mxCell id="27957-27" value="&lt;b&gt;Version restore&lt;/b&gt;&lt;br&gt;evidenceFiles is authoritative: diffed against the live Qdrant set and reconciled; re-ingest clears the ledger entry (self-healing)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#000000;align=left;" vertex="1" parent="1"><mxGeometry x="500" y="720" width="420" height="150" as="geometry"/></mxCell><mxCell id="27957-28" value="&lt;b&gt;Single-document reload&lt;/b&gt;&lt;br&gt;Vectors and manifest entry purged before re-fetch; ledger written only if the re-read fails, cleared when it succeeds" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#000000;align=left;" vertex="1" parent="1"><mxGeometry x="940" y="720" width="420" height="150" as="geometry"/></mxCell><mxCell id="27957-29" value="&lt;b&gt;Embedding model change&lt;/b&gt;&lt;br&gt;New collection; migrate with reindex_chunks.py --from-collection, then delete the old collection (a purge does not reach it)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#000000;align=left;" vertex="1" parent="1"><mxGeometry x="1380" y="720" width="460" height="150" as="geometry"/></mxCell><mxCell id="27957-30" value="&lt;b&gt;Personal data&lt;/b&gt;: PII is redacted before any model call, vector write or log. Participant names are app users, not parties: kept out of legal prompts. Coverage: tests/offline/verify_workspace_share.py, verify_document_reload.py; purge in scripts/e2e_local_backend.py." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#000000;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="930" width="1820" height="50" as="geometry"/></mxCell><mxCell id="27957-31" value="&lt;b&gt;Key&lt;/b&gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="1004" width="60" height="24" as="geometry"/></mxCell><mxCell id="27957-32" value="&lt;font style='font-size:10px'&gt;Inbound event / trigger&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#000000;align=left;" vertex="1" parent="1"><mxGeometry x="90" y="1000" width="158" height="30" as="geometry"/></mxCell><mxCell id="27957-33" value="&lt;font style='font-size:10px'&gt;Processing step&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#000000;align=left;" vertex="1" parent="1"><mxGeometry x="258" y="1000" width="158" height="30" as="geometry"/></mxCell><mxCell id="27957-34" value="&lt;font style='font-size:10px'&gt;Control / guard&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#000000;align=left;" vertex="1" parent="1"><mxGeometry x="426" y="1000" width="158" height="30" as="geometry"/></mxCell><mxCell id="27957-35" value="&lt;font style='font-size:10px'&gt;Output / emit&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#000000;align=left;" vertex="1" parent="1"><mxGeometry x="594" y="1000" width="158" height="30" as="geometry"/></mxCell><mxCell id="27957-36" value="&lt;font style='font-size:10px'&gt;Component&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="762" y="1000" width="158" height="30" as="geometry"/></mxCell><mxCell id="27957-37" value="&lt;font style='font-size:10px'&gt;Optional&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#FFFFFF;strokeColor=#438DD5;fontColor=#1A1A1A;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="930" y="1000" width="158" height="30" as="geometry"/></mxCell><mxCell id="27957-38" value="&lt;font style='font-size:10px'&gt;Data store&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=5;fontSize=11;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;spacing=4;" vertex="1" parent="1"><mxGeometry x="1098" y="1000" width="158" height="30" as="geometry"/></mxCell><mxCell id="27957-39" value="&lt;font style='font-size:10px'&gt;External system&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1266" y="1000" width="158" height="30" as="geometry"/></mxCell><mxCell id="27957-40" value="&lt;font style='font-size:10px'&gt;Rule / note&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#000000;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1434" y="1000" width="158" height="30" as="geometry"/></mxCell><mxCell id="27957-41" value="SimplerToday AI service · C4 model notation · reflects branch feature/SIM-9-claude-structure at commit 7940542 (2026-10-14) · source of truth: CLAUDE.md and docs/architecture.md · page: 9. Data, state and erasure" style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="1046" width="1840" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3109523929" name="10. Deployment and runtime"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1080" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="523929-1" value="10 · Deployment and runtime" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="16" width="1840" height="34" as="geometry"/></mxCell><mxCell id="523929-2" value="Production runs on Google Cloud Compute Engine VMs. The container and configuration below come from the repository; VM provisioning is managed outside it." style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="52" width="1840" height="40" as="geometry"/></mxCell><mxCell id="523929-3" value="Production: Google Cloud Compute Engine VM (restart policy required)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="900" height="560" as="geometry"/></mxCell><mxCell id="523929-4" value="&lt;b&gt;simplertoday-ai container&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;[Dockerfile: multi-stage, python:3.12-slim]&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Build stage compiles wheels from requirements.lock.txt (exact tested versions). Runtime: ffmpeg, poppler-utils, antiword; non-root user app (uid 10001); copies only app/; CMD python -m app.main. No HEALTHCHECK and no port: liveness is the ai_heartbeat_ping round trip; the process exits on a fatal error&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="70" y="160" width="420" height="260" as="geometry"/></mxCell><mxCell id="523929-5" value="&lt;b&gt;Configuration&lt;/b&gt;&lt;br&gt;--env-file .env (SOCKET_URL, SOCKET_SECRET_KEY, GOOGLE_API_KEY, QDRANT_URL, SECRET_KEY, LLM_*, GATE0_* …). Nothing secret baked into the image" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#000000;align=left;" vertex="1" parent="1"><mxGeometry x="520" y="160" width="390" height="120" as="geometry"/></mxCell><mxCell id="523929-6" value="&lt;b&gt;GCP service account&lt;/b&gt;&lt;br&gt;Mounted read-only at /run/secrets; GOOGLE_APPLICATION_CREDENTIALS (and SPEECH_…) point at it" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#000000;align=left;" vertex="1" parent="1"><mxGeometry x="520" y="300" width="390" height="120" as="geometry"/></mxCell><mxCell id="523929-7" value="&lt;b&gt;Volumes&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;[simplertoday-logs → /app/logs, simplertoday-data → /app/data]&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Logs (audit kept a year) and saved workspace files&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fontSize=11;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;spacing=4;" vertex="1" parent="1"><mxGeometry x="70" y="460" width="420" height="160" as="geometry"/></mxCell><mxCell id="523929-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.23;entryDx=0;entryDy=0;" edge="1" parent="1" source="523929-5" target="523929-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="523929-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.77;entryDx=0;entryDy=0;" edge="1" parent="1" source="523929-6" target="523929-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="523929-10" value="Writes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="523929-4" target="523929-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="523929-11" value="&lt;b&gt;Qdrant (managed or self-hosted)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;[QDRANT_URL]&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Must be reachable from the container&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fontSize=11;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;spacing=4;" vertex="1" parent="1"><mxGeometry x="520" y="460" width="390" height="160" as="geometry"/></mxCell><mxCell id="523929-12" value="Reads / writes [HTTP / gRPC]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="523929-4" target="523929-11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="448" y="440"/><mxPoint x="715" y="440"/></Array></mxGeometry></mxCell><mxCell id="523929-13" value="Local development (docker-compose.yml + make)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="980" y="110" width="880" height="560" as="geometry"/></mxCell><mxCell id="523929-14" value="&lt;b&gt;qdrant&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;[qdrant/qdrant:latest]&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;6333 HTTP, 6334 gRPC; volume qdrant_storage&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fontSize=11;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;spacing=4;" vertex="1" parent="1"><mxGeometry x="1010" y="160" width="250" height="140" as="geometry"/></mxCell><mxCell id="523929-15" value="&lt;b&gt;redis&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;[redis:7-alpine, appendonly]&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;6379; not used by service code&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fontSize=11;fillColor=#FFFFFF;strokeColor=#438DD5;fontColor=#1A1A1A;dashed=1;dashPattern=6 4;spacing=4;" vertex="1" parent="1"><mxGeometry x="1290" y="160" width="250" height="140" as="geometry"/></mxCell><mxCell id="523929-16" value="&lt;b&gt;neo4j&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;[neo4j:5-community, profile graph]&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;127.0.0.1:7474 / 7687; NEO4J_PASSWORD from .env&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fontSize=11;fillColor=#FFFFFF;strokeColor=#438DD5;fontColor=#1A1A1A;dashed=1;dashPattern=6 4;spacing=4;" vertex="1" parent="1"><mxGeometry x="1570" y="160" width="260" height="140" as="geometry"/></mxCell><mxCell id="523929-17" value="&lt;b&gt;make run / ./dev.sh start&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;[local venv (env/)]&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;python -m app.main against a connected backend; make setup creates venv, .env, logs/, data/&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1010" y="340" width="520" height="140" as="geometry"/></mxCell><mxCell id="523929-18" value="&lt;b&gt;make e2e&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;[scripts/e2e_local_backend.py, started by a human]&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Real service + local stand-in backend: handshake, seven panels, chat with citations, stop / resume, purge, log scan. Real billed Gemini calls; throwaway Qdrant collection&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#FFFFFF;strokeColor=#438DD5;fontColor=#1A1A1A;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1010" y="510" width="520" height="130" as="geometry"/></mxCell><mxCell id="523929-19" value="Uses" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;exitX=0.24;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="523929-17" target="523929-14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="523929-20" value="Drives" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;dashed=1;dashPattern=2 4;strokeColor=#999999;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="523929-18" target="523929-17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="523929-21" value="Outbound network required (no inbound ports)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="1820" height="200" as="geometry"/></mxCell><mxCell id="523929-22" value="&lt;b&gt;Backend&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;WSS Socket.IO&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="60" y="750" width="280" height="110" as="geometry"/></mxCell><mxCell id="523929-23" value="&lt;b&gt;Evidence storage&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;HTTPS signed URLs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="360" y="750" width="280" height="110" as="geometry"/></mxCell><mxCell id="523929-24" value="&lt;b&gt;LLM / gate0&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;HTTPS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="660" y="750" width="280" height="110" as="geometry"/></mxCell><mxCell id="523929-25" value="&lt;b&gt;Google Cloud APIs&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Vision, Speech, Vertex, GCS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="960" y="750" width="280" height="110" as="geometry"/></mxCell><mxCell id="523929-26" value="&lt;b&gt;Indian Kanoon&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;HTTPS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1260" y="750" width="280" height="110" as="geometry"/></mxCell><mxCell id="523929-27" value="&lt;b&gt;Qdrant / Neo4j&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;HTTP-gRPC / Bolt&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1560" y="750" width="280" height="110" as="geometry"/></mxCell><mxCell id="523929-28" value="&lt;b&gt;Operations&lt;/b&gt;: one request_id per inbound event (filter logs on it); 'event … finished in Xs status=…', 'result &amp;lt;featureType&amp;gt; delivered=yes|no', one llm_call line per model call. Ship logs/structured.log (JSON) to the log platform; keep logs/audit/ for a year. Before a deploy: make lint, make test, make e2e." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#000000;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="930" width="1820" height="50" as="geometry"/></mxCell><mxCell id="523929-29" value="&lt;b&gt;Key&lt;/b&gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="1004" width="60" height="24" as="geometry"/></mxCell><mxCell id="523929-30" value="&lt;font style='font-size:10px'&gt;Inbound event / trigger&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#000000;align=left;" vertex="1" parent="1"><mxGeometry x="90" y="1000" width="158" height="30" as="geometry"/></mxCell><mxCell id="523929-31" value="&lt;font style='font-size:10px'&gt;Processing step&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#000000;align=left;" vertex="1" parent="1"><mxGeometry x="258" y="1000" width="158" height="30" as="geometry"/></mxCell><mxCell id="523929-32" value="&lt;font style='font-size:10px'&gt;Control / guard&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#000000;align=left;" vertex="1" parent="1"><mxGeometry x="426" y="1000" width="158" height="30" as="geometry"/></mxCell><mxCell id="523929-33" value="&lt;font style='font-size:10px'&gt;Output / emit&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#000000;align=left;" vertex="1" parent="1"><mxGeometry x="594" y="1000" width="158" height="30" as="geometry"/></mxCell><mxCell id="523929-34" value="&lt;font style='font-size:10px'&gt;Component&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="762" y="1000" width="158" height="30" as="geometry"/></mxCell><mxCell id="523929-35" value="&lt;font style='font-size:10px'&gt;Optional&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#FFFFFF;strokeColor=#438DD5;fontColor=#1A1A1A;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="930" y="1000" width="158" height="30" as="geometry"/></mxCell><mxCell id="523929-36" value="&lt;font style='font-size:10px'&gt;Data store&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=5;fontSize=11;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;spacing=4;" vertex="1" parent="1"><mxGeometry x="1098" y="1000" width="158" height="30" as="geometry"/></mxCell><mxCell id="523929-37" value="&lt;font style='font-size:10px'&gt;External system&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1266" y="1000" width="158" height="30" as="geometry"/></mxCell><mxCell id="523929-38" value="&lt;font style='font-size:10px'&gt;Rule / note&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#000000;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1434" y="1000" width="158" height="30" as="geometry"/></mxCell><mxCell id="523929-39" value="SimplerToday AI service · C4 model notation · reflects branch feature/SIM-9-claude-structure at commit 7940542 (2026-10-14) · source of truth: CLAUDE.md and docs/architecture.md · page: 10. Deployment and runtime" style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="1046" width="1840" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="2603102248" name="11. Security and trust boundaries"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="102248-1" value="11 · Security, privacy and trust boundaries" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="16" width="1840" height="34" as="geometry"/></mxCell><mxCell id="102248-2" value="Controls the code enforces, grouped by trust zone. Red dashed = boundary crossed by data." style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="52" width="1840" height="40" as="geometry"/></mxCell><mxCell id="102248-3" value="Zone A: Application backend (trusted peer)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#B85450;dashed=1;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="420" height="560" as="geometry"/></mxCell><mxCell id="102248-4" value="Zone B: AI service runtime" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#B85450;dashed=1;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="500" y="110" width="820" height="560" as="geometry"/></mxCell><mxCell id="102248-5" value="Zone C: Third-party processors" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#B85450;dashed=1;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1360" y="110" width="500" height="560" as="geometry"/></mxCell><mxCell id="102248-6" value="&lt;b&gt;Backend&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;[Socket.IO server]&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Verifies the AI service's signed handshake; sends events and signed evidence URLs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="70" y="160" width="360" height="120" as="geometry"/></mxCell><mxCell id="102248-7" value="&lt;b&gt;Handshake authentication&lt;/b&gt; (socket/auth.py)&lt;br&gt;Scheme v1: HMAC over v1:AI_Maverick:&amp;lt;unix_seconds&amp;gt;:&amp;lt;nonce&amp;gt;; headers x-signature / timestamp / nonce are single-use and rebuilt on every reconnect (callable). SOCKET_AUTH_SCHEME=legacy is rollback only" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#000000;align=left;" vertex="1" parent="1"><mxGeometry x="70" y="320" width="360" height="160" as="geometry"/></mxCell><mxCell id="102248-8" value="Spec and failure codes: docs/AI_SERVICE_AUTH_MIGRATION.md. Transport: WSS to SOCKET_URL." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#000000;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="70" y="510" width="360" height="130" as="geometry"/></mxCell><mxCell id="102248-9" value="&lt;b&gt;Role gate&lt;/b&gt;: no validated role, no downstream agent" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#000000;align=left;" vertex="1" parent="1"><mxGeometry x="520" y="150" width="780" height="54" as="geometry"/></mxCell><mxCell id="102248-10" value="&lt;b&gt;Sharing permissions&lt;/b&gt;: resolve_asker; view = read-only; every chat mutation gated on mutations_allowed" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#000000;align=left;" vertex="1" parent="1"><mxGeometry x="520" y="212" width="780" height="54" as="geometry"/></mxCell><mxCell id="102248-11" value="&lt;b&gt;PII redaction&lt;/b&gt; before any model call, vector write or log (scan_text, redact_tableset)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#000000;align=left;" vertex="1" parent="1"><mxGeometry x="520" y="274" width="780" height="54" as="geometry"/></mxCell><mxCell id="102248-12" value="&lt;b&gt;Secrets&lt;/b&gt; only from env (pydantic SecretStr); none in code or image; credential files gitignored" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#000000;align=left;" vertex="1" parent="1"><mxGeometry x="520" y="336" width="780" height="54" as="geometry"/></mxCell><mxCell id="102248-13" value="&lt;b&gt;Logging hygiene&lt;/b&gt;: no payloads, prompts, model output, names or URLs; chars(), safe_url(); tracebacks without locals unless LOG_DIAGNOSE" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#000000;align=left;" vertex="1" parent="1"><mxGeometry x="520" y="398" width="780" height="54" as="geometry"/></mxCell><mxCell id="102248-14" value="&lt;b&gt;Audit trail&lt;/b&gt;: logs/audit/audit.log (kept a year), e.g. workspace_purge_failed" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#000000;align=left;" vertex="1" parent="1"><mxGeometry x="520" y="460" width="780" height="54" as="geometry"/></mxCell><mxCell id="102248-15" value="&lt;b&gt;Compliance erasure&lt;/b&gt;: every copy (memory, Qdrant, graph, disk), retries and escalates" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#000000;align=left;" vertex="1" parent="1"><mxGeometry x="520" y="522" width="780" height="54" as="geometry"/></mxCell><mxCell id="102248-16" value="&lt;b&gt;Container&lt;/b&gt;: non-root uid 10001; read-only secret mount; no listening port" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#000000;align=left;" vertex="1" parent="1"><mxGeometry x="520" y="584" width="780" height="54" as="geometry"/></mxCell><mxCell id="102248-17" value="&lt;b&gt;Model-call governance&lt;/b&gt;&lt;br&gt;Every call through the router; under GATE0_ENFORCE nothing may bypass gate0. Content-filter blocks are final" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#000000;align=left;" vertex="1" parent="1"><mxGeometry x="1380" y="150" width="460" height="120" as="geometry"/></mxCell><mxCell id="102248-18" value="&lt;b&gt;LLM providers / gate0&lt;/b&gt;&lt;br&gt;Receive redacted text only" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1380" y="300" width="460" height="100" as="geometry"/></mxCell><mxCell id="102248-19" value="&lt;b&gt;Google Cloud&lt;/b&gt; (Vision, Speech, Vertex, GCS)&lt;br&gt;Service-account auth; OCR sees raw scans" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1380" y="420" width="460" height="100" as="geometry"/></mxCell><mxCell id="102248-20" value="&lt;b&gt;Indian Kanoon&lt;/b&gt;&lt;br&gt;Outbound fetch of public pages; no case data sent" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1380" y="540" width="460" height="100" as="geometry"/></mxCell><mxCell id="102248-21" value="Delivery-time controls (repository)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="1820" height="200" as="geometry"/></mxCell><mxCell id="102248-22" value="&lt;b&gt;pre-commit&lt;/b&gt;: gitleaks secret scan, detect-private-key, large files, merge conflicts, YAML / JSON, ruff" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#000000;align=left;" vertex="1" parent="1"><mxGeometry x="60" y="750" width="430" height="130" as="geometry"/></mxCell><mxCell id="102248-23" value="&lt;b&gt;Claude Code hooks&lt;/b&gt;: block-secrets.sh (credential files), protect-branch.sh (no commit on shared branches, no --no-verify, no push), validate-code.sh (ruff)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#000000;align=left;" vertex="1" parent="1"><mxGeometry x="510" y="750" width="430" height="130" as="geometry"/></mxCell><mxCell id="102248-24" value="&lt;b&gt;Tests&lt;/b&gt;: test_llm_router.py blocks provider SDK imports outside llm/providers; verify_logging.py statically scans every log call" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#000000;align=left;" vertex="1" parent="1"><mxGeometry x="960" y="750" width="430" height="130" as="geometry"/></mxCell><mxCell id="102248-25" value="&lt;b&gt;Review&lt;/b&gt;: reviewer + security-auditor agents; needs-human-review label for payload, role gate, purge, PII, billing or routing changes" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#000000;align=left;" vertex="1" parent="1"><mxGeometry x="1410" y="750" width="430" height="130" as="geometry"/></mxCell><mxCell id="102248-26" value="&lt;b&gt;Open risks to track&lt;/b&gt; (not enforced by code): GCP service-account and other credential files sit in the working-tree root (gitignored; move out and rotate any key that was ever pushed) · no CI pipeline yet, so gates run only locally · Redis in docker-compose has no password by default (unused today) · OCR and transcription send unredacted content to Google Cloud by design." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#000000;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="930" width="1820" height="60" as="geometry"/></mxCell><mxCell id="102248-27" value="&lt;b&gt;Key&lt;/b&gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="1024" width="60" height="24" as="geometry"/></mxCell><mxCell id="102248-28" value="&lt;font style='font-size:10px'&gt;Inbound event / trigger&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#000000;align=left;" vertex="1" parent="1"><mxGeometry x="90" y="1020" width="158" height="30" as="geometry"/></mxCell><mxCell id="102248-29" value="&lt;font style='font-size:10px'&gt;Processing step&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#000000;align=left;" vertex="1" parent="1"><mxGeometry x="258" y="1020" width="158" height="30" as="geometry"/></mxCell><mxCell id="102248-30" value="&lt;font style='font-size:10px'&gt;Control / guard&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#000000;align=left;" vertex="1" parent="1"><mxGeometry x="426" y="1020" width="158" height="30" as="geometry"/></mxCell><mxCell id="102248-31" value="&lt;font style='font-size:10px'&gt;Output / emit&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#000000;align=left;" vertex="1" parent="1"><mxGeometry x="594" y="1020" width="158" height="30" as="geometry"/></mxCell><mxCell id="102248-32" value="&lt;font style='font-size:10px'&gt;Component&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="762" y="1020" width="158" height="30" as="geometry"/></mxCell><mxCell id="102248-33" value="&lt;font style='font-size:10px'&gt;Optional&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#FFFFFF;strokeColor=#438DD5;fontColor=#1A1A1A;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="930" y="1020" width="158" height="30" as="geometry"/></mxCell><mxCell id="102248-34" value="&lt;font style='font-size:10px'&gt;Data store&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=5;fontSize=11;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;spacing=4;" vertex="1" parent="1"><mxGeometry x="1098" y="1020" width="158" height="30" as="geometry"/></mxCell><mxCell id="102248-35" value="&lt;font style='font-size:10px'&gt;External system&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1266" y="1020" width="158" height="30" as="geometry"/></mxCell><mxCell id="102248-36" value="&lt;font style='font-size:10px'&gt;Rule / note&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#000000;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1434" y="1020" width="158" height="30" as="geometry"/></mxCell><mxCell id="102248-37" value="SimplerToday AI service · C4 model notation · reflects branch feature/SIM-9-claude-structure at commit 7940542 (2026-10-14) · source of truth: CLAUDE.md and docs/architecture.md · page: 11. Security and trust boundaries" style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="1066" width="1840" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="2454484789" name="12. Delivery workflow (agentic SDLC)"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1060" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="484789-1" value="12 · Delivery workflow: Jira → specs → agents → PR → release" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="16" width="1840" height="34" as="geometry"/></mxCell><mxCell id="484789-2" value="docs/development-workflow.md. Jira project SIM. Agents never push, merge or run make e2e; a human does." style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="52" width="1840" height="40" as="geometry"/></mxCell><mxCell id="484789-3" value="&lt;b&gt;Jira issue&lt;/b&gt;&lt;br&gt;SIM-&amp;lt;n&amp;gt;, goal and scope&lt;br&gt;&lt;i&gt;To Do&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#000000;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="240" height="140" as="geometry"/></mxCell><mxCell id="484789-4" value="&lt;b&gt;/spec → planner&lt;/b&gt;&lt;br&gt;specs/requirements, technical-design, acceptance-criteria&lt;br&gt;&lt;i&gt;Spec Review&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#000000;align=left;" vertex="1" parent="1"><mxGeometry x="302" y="140" width="240" height="140" as="geometry"/></mxCell><mxCell id="484789-5" value="" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;" edge="1" parent="1" source="484789-3" target="484789-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="484789-6" value="&lt;b&gt;Design approval&lt;/b&gt;&lt;br&gt;owner + tech 