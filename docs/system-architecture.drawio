<mxfile host="app.diagrams.net" type="device" version="24.7.17"><diagram id="3235373478" name="1. System context (C4 L1)"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1080" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="373478-1" value="1 · System context (C4 level 1): SimplerToday AI service" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="16" width="1740" height="34" as="geometry"/></mxCell><mxCell id="373478-2" value="Who uses the system and which external systems it depends on. The AI service is an outbound Socket.IO &lt;b&gt;client&lt;/b&gt;: it opens every connection itself and exposes no HTTP API or listening port. Its own data stores (Qdrant, optional Neo4j, volumes) are inside the system: see page 2." style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="52" width="1740" height="40" as="geometry"/></mxCell><mxCell id="373478-3" value="&lt;b&gt;Lawyer (workspace owner)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;[Person]&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Uploads evidence, sets role and objective, reads panels, chats, drafts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;arcSize=30;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="220" height="110" as="geometry"/></mxCell><mxCell id="373478-4" value="&lt;b&gt;Collaborator&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;[Person]&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Shared workspace; permission edit or view (view is read-only)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;arcSize=30;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="220" height="110" as="geometry"/></mxCell><mxCell id="373478-5" value="&lt;b&gt;SimplerToday web app&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;[Software system: frontend (Web_Maverick)]&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Panels, chat, drafting, Supporting Material&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="400" y="210" width="250" height="130" as="geometry"/></mxCell><mxCell id="373478-6" value="&lt;b&gt;Application backend&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;[Software system: Socket.IO server + document storage]&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Owns users, workspaces, documents and versions; relays events between web app and AI service; serves evidence files by signed URL&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="800" y="170" width="300" height="170" as="geometry"/></mxCell><mxCell id="373478-7" value="&lt;b&gt;SimplerToday AI service&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;[Software system: Python 3.12 asyncio, this repository]&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Ingests evidence, generates the seven case panels, governed chat with checked citations, drafting, compliance erasure&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="800" y="520" width="300" height="180" as="geometry"/></mxCell><mxCell id="373478-8" value="&lt;b&gt;gate0 LLM gateway&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;[Software system: LiteLLM proxy, optional]&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Governance and spend control; mandatory for every model call when GATE0_ENFORCE=true&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#FFFFFF;strokeColor=#736782;fontColor=#1A1A1A;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="380" y="470" width="260" height="130" as="geometry"/></mxCell><mxCell id="373478-9" value="&lt;b&gt;LLM providers&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;[Software systems]&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Gemini (default), OpenAI, Azure OpenAI, Azure AI Foundry, AWS Bedrock, SageMaker, OpenAI-compatible (DeepSeek, Qwen, Llama)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="380" y="700" width="260" height="140" as="geometry"/></mxCell><mxCell id="373478-10" value="&lt;b&gt;Google Cloud AI APIs&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;[Software system]&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Vision OCR, Speech-to-Text V2 (Chirp 3), Vertex AI Search, Google Search grounding&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="760" y="830" width="260" height="150" as="geometry"/></mxCell><mxCell id="373478-11" value="&lt;b&gt;Google Cloud Storage&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;[Software system]&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Audio staging for batch transcription, generated DOCX exports&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1080" y="830" width="220" height="120" as="geometry"/></mxCell><mxCell id="373478-12" value="&lt;b&gt;Indian Kanoon&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;[Software system: public website]&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Statute and judgment pages for applicable laws and case laws&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1260" y="470" width="250" height="110" as="geometry"/></mxCell><mxCell id="373478-13" value="&lt;b&gt;India Code&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;[Software system: public website]&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Source of the bundled statute index; fetched offline by scripts, never at runtime&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#FFFFFF;strokeColor=#736782;fontColor=#1A1A1A;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1260" y="640" width="250" height="110" as="geometry"/></mxCell><mxCell id="373478-14" value="Uses [browser]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;" edge="1" parent="1" source="373478-3" target="373478-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="373478-15" value="Uses a shared case [browser]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;" edge="1" parent="1" source="373478-4" target="373478-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="373478-16" value="Reads / writes cases&lt;br&gt;[REST, Socket.IO]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;" edge="1" parent="1" source="373478-5" target="373478-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="373478-17" value="Connects out, emits panels and replies,&lt;br&gt;downloads evidence&lt;br&gt;[Socket.IO over WSS, HMAC-signed; HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;exitX=0.3;exitY=0;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="373478-7" target="373478-6"><mxGeometry relative="1" as="geometry"><mxPoint x="-150" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="373478-18" value="Sends workspace, document&lt;br&gt;and chat events&lt;br&gt;[Socket.IO]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="373478-6" target="373478-7"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="373478-19" value="Model calls when configured&lt;br&gt;[HTTPS, OpenAI-style API]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;dashed=1;dashPattern=2 4;strokeColor=#999999;exitX=0;exitY=0.25;exitDx=0;exitDy=0;entryX=1;entryY=0.73;entryDx=0;entryDy=0;" edge="1" parent="1" source="373478-7" target="373478-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="373478-20" value="Routes to [HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;dashed=1;dashPattern=2 4;strokeColor=#999999;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="373478-8" target="373478-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="373478-21" value="Generate, embed (direct)&lt;br&gt;[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="373478-7" target="373478-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="373478-22" value="OCR, transcription, search&lt;br&gt;[HTTPS / gRPC]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="373478-7" target="373478-10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="373478-23" value="Uploads / downloads objects&lt;br&gt;[GCS API]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="373478-7" target="373478-11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="373478-24" value="Fetches law and judgment&lt;br&gt;pages [HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;exitX=1;exitY=0.15;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="373478-7" target="373478-12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="373478-25" value="Offline: statute index&lt;br&gt;build [scripts]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;dashed=1;dashPattern=2 4;strokeColor=#999999;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.97;entryDx=0;entryDy=0;" edge="1" parent="1" source="373478-13" target="373478-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="373478-26" value="Legend" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1530" y="130" width="250" height="292" as="geometry"/></mxCell><mxCell id="373478-27" value="Person" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;arcSize=30;" vertex="1" parent="1"><mxGeometry x="1542" y="162" width="226" height="30" as="geometry"/></mxCell><mxCell id="373478-28" value="This software system" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1542" y="198" width="226" height="30" as="geometry"/></mxCell><mxCell id="373478-29" value="Container / process" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1542" y="234" width="226" height="30" as="geometry"/></mxCell><mxCell id="373478-30" value="Component (Python package)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1542" y="270" width="226" height="30" as="geometry"/></mxCell><mxCell id="373478-31" value="External system" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1542" y="306" width="226" height="30" as="geometry"/></mxCell><mxCell id="373478-32" value="Data store" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=5;fontSize=11;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;spacing=4;" vertex="1" parent="1"><mxGeometry x="1542" y="342" width="226" height="30" as="geometry"/></mxCell><mxCell id="373478-33" value="Optional / off by default" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#FFFFFF;strokeColor=#438DD5;fontColor=#1A1A1A;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1542" y="378" width="226" height="30" as="geometry"/></mxCell><mxCell id="373478-34" value="&lt;b&gt;Key properties&lt;/b&gt;&lt;br&gt;• Event driven: no inbound port, no HTTP API&lt;br&gt;• Indian law framing (BNS / BNSS / BSA / IT Act)&lt;br&gt;• Role gate: nothing runs without a validated role&lt;br&gt;• Every model call is provider-neutral and metered&lt;br&gt;• Deleting a workspace erases every AI-held copy" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#000000;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1200" y="190" width="300" height="150" as="geometry"/></mxCell><mxCell id="373478-35" value="SimplerToday AI service · C4 model notation · reflects branch feature/SIM-9-claude-structure at commit 7940542 (2026-10-14) · source of truth: CLAUDE.md and docs/architecture.md · page: 1. System context (C4 L1)" style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="1046" width="1740" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3239863838" name="2. Containers (C4 L2)"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1060" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="863838-1" value="2 · Containers (C4 level 2)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="16" width="1840" height="34" as="geometry"/></mxCell><mxCell id="863838-2" value="The runtime pieces inside the system boundary, what each stores and how they talk. Local development runs the data stores from docker-compose.yml; production runs the Docker image built from Dockerfile." style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="52" width="1840" height="40" as="geometry"/></mxCell><mxCell id="863838-3" value="SimplerToday AI service [Software system]" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#444444;dashed=1;dashPattern=8 4;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;container=0;" vertex="1" parent="1"><mxGeometry x="330" y="110" width="700" height="760" as="geometry"/></mxCell><mxCell id="863838-4" value="&lt;b&gt;AI service process&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;[Container: Python 3.12, asyncio, python-socketio, LangGraph; python -m app.main]&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Socket client + SocketEventHandler (per-feature handler mixins), LangGraph agents, document processing, RAG and citations, model router, usage ledger, logging. Bundles the statute index (app/statutes/data: 165 acts, 12,530 sections). Startup: Qdrant store → document processor → model client → knowledge plane (non-strict) → socket client&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="420" y="170" width="580" height="200" as="geometry"/></mxCell><mxCell id="863838-5" value="&lt;b&gt;Qdrant&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;[Container: vector database]&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&amp;lt;collection&amp;gt;: state and role caches&lt;br&gt;_evidence_v1: chunks, dense + sparse&lt;br&gt;_tables_v1: spreadsheet rows&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fontSize=11;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;spacing=4;" vertex="1" parent="1"><mxGeometry x="360" y="440" width="200" height="200" as="geometry"/></mxCell><mxCell id="863838-6" value="&lt;b&gt;Neo4j&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;[Container: neo4j:5-community, optional]&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Legal ontology graph. Augment only, never gating; off unless NEO4J_URL is set&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fontSize=11;fillColor=#FFFFFF;strokeColor=#438DD5;fontColor=#1A1A1A;dashed=1;dashPattern=6 4;spacing=4;" vertex="1" parent="1"><mxGeometry x="580" y="440" width="200" height="200" as="geometry"/></mxCell><mxCell id="863838-7" value="&lt;b&gt;Volumes&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;[Container: /app/logs, /app/data]&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;app, errors, structured (JSON) logs; audit/audit.log kept a year; data/workspaces&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fontSize=11;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;spacing=4;" vertex="1" parent="1"><mxGeometry x="800" y="440" width="200" height="200" as="geometry"/></mxCell><mxCell id="863838-8" value="&lt;b&gt;Redis&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;[Container: redis:7-alpine, docker-compose only]&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Provisioned and configured (REDIS_*), but no service code uses it today&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#FFFFFF;strokeColor=#736782;fontColor=#1A1A1A;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="360" y="700" width="300" height="120" as="geometry"/></mxCell><mxCell id="863838-9" value="&lt;b&gt;Offline tooling&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;[Container: Python CLIs in scripts/, run by a person]&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;e2e_local_backend · eval_rag · reindex_chunks · fetch_laws_indiacode + build_statute_index · smoke_llm_providers · reconcile_gate0_spend&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#FFFFFF;strokeColor=#438DD5;fontColor=#1A1A1A;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="680" y="700" width="320" height="140" as="geometry"/></mxCell><mxCell id="863838-10" value="&lt;b&gt;Application backend&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;[Software system]&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Socket.IO server and document storage&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="30" y="170" width="200" height="200" as="geometry"/></mxCell><mxCell id="863838-11" value="&lt;b&gt;gate0 gateway&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;[Software system: LiteLLM]&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Virtual key per service; spend tags per workspace&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#FFFFFF;strokeColor=#736782;fontColor=#1A1A1A;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1430" y="130" width="240" height="110" as="geometry"/></mxCell><mxCell id="863838-12" value="&lt;b&gt;LLM providers&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;[Software systems]&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Gemini, OpenAI, Azure OpenAI / Foundry, Bedrock, SageMaker, OpenAI-compatible&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1430" y="280" width="240" height="130" as="geometry"/></mxCell><mxCell id="863838-13" value="&lt;b&gt;Google Cloud AI APIs&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;[Software system]&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Vision, Speech-to-Text V2, Vertex AI Search, Search grounding&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1430" y="450" width="240" height="120" as="geometry"/></mxCell><mxCell id="863838-14" value="&lt;b&gt;Google Cloud Storage&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;[Software system]&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Audio staging, DOCX export bucket&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#8C8496;strok