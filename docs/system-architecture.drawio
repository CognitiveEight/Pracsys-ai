itDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="863838-9" target="863838-5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="712" y="670"/><mxPoint x="460" y="670"/></Array></mxGeometry></mxCell><mxCell id="863838-28" value="Legend" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="250" height="292" as="geometry"/></mxCell><mxCell id="863838-29" value="Person" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;arcSize=30;" vertex="1" parent="1"><mxGeometry x="52" y="472" width="226" height="30" as="geometry"/></mxCell><mxCell id="863838-30" value="This software system" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="52" y="508" width="226" height="30" as="geometry"/></mxCell><mxCell id="863838-31" value="Container / process" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="52" y="544" width="226" height="30" as="geometry"/></mxCell><mxCell id="863838-32" value="Component (Python package)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="52" y="580" width="226" height="30" as="geometry"/></mxCell><mxCell id="863838-33" value="External system" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="52" y="616" width="226" height="30" as="geometry"/></mxCell><mxCell id="863838-34" value="Data store" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=5;fontSize=11;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;spacing=4;" vertex="1" parent="1"><mxGeometry x="52" y="652" width="226" height="30" as="geometry"/></mxCell><mxCell id="863838-35" value="Optional / off by default" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#FFFFFF;strokeColor=#438DD5;fontColor=#1A1A1A;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="52" y="688" width="226" height="30" as="geometry"/></mxCell><mxCell id="863838-36" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;• Every per-workspace in-memory cache is mirrored to Qdrant (write-through) and hydrated on a cold workspace, so a restart or reconnect re-emits cached panels.&lt;br&gt;• An embedding provider, model or dimension change is a new evidence collection: migrate with scripts/reindex_chunks.py --from-collection.&lt;br&gt;• Keel (keel/) and pracsys2.0/ are vendored or reference trees: not part of the running service." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#000000;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="330" y="900" width="1340" height="80" as="geometry"/></mxCell><mxCell id="863838-37" value="SimplerToday AI service · C4 model notation · reflects branch feature/SIM-9-claude-structure at commit 7940542 (2026-10-14) · source of truth: CLAUDE.md and docs/architecture.md · page: 2. Containers (C4 L2)" style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="1026" width="1840" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="220988805" name="3. Components (C4 L3)"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1950" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="988805-1" value="3 · Components of the AI service process (C4 level 3)" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="16" width="1890" height="34" as="geometry"/></mxCell><mxCell id="988805-2" value="Packages under app/ grouped in layers; arrows show the main call direction. app/socket/events.py is a thin composition root: SocketEventHandler = the handler mixins in app/socket/handlers/." style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="52" width="1890" height="40" as="geometry"/></mxCell><mxCell id="988805-3" value="Entry and socket" style="swimlane;horizontal=0;startSize=30;html=1;whiteSpace=wrap;fillColor=#F5F5F5;swimlaneFillColor=#FAFAFA;strokeColor=#999999;fontSize=12;fontStyle=1;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="1890" height="170" as="geometry"/></mxCell><mxCell id="988805-4" value="Handlers (mixins)" style="swimlane;horizontal=0;startSize=30;html=1;whiteSpace=wrap;fillColor=#F5F5F5;swimlaneFillColor=#FAFAFA;strokeColor=#999999;fontSize=12;fontStyle=1;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="30" y="300" width="1890" height="250" as="geometry"/></mxCell><mxCell id="988805-5" value="Agents and prompts" style="swimlane;horizontal=0;startSize=30;html=1;whiteSpace=wrap;fillColor=#F5F5F5;swimlaneFillColor=#FAFAFA;strokeColor=#999999;fontSize=12;fontStyle=1;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="30" y="570" width="1890" height="230" as="geometry"/></mxCell><mxCell id="988805-6" value="Evidence and retrieval" style="swimlane;horizontal=0;startSize=30;html=1;whiteSpace=wrap;fillColor=#F5F5F5;swimlaneFillColor=#FAFAFA;strokeColor=#999999;fontSize=12;fontStyle=1;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="30" y="820" width="1890" height="250" as="geometry"/></mxCell><mxCell id="988805-7" value="Platform services (all layers)" style="swimlane;horizontal=0;startSize=30;html=1;whiteSpace=wrap;fillColor=#F5F5F5;swimlaneFillColor=#FAFAFA;strokeColor=#999999;fontSize=12;fontStyle=1;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="30" y="1090" width="1890" height="220" as="geometry"/></mxCell><mxCell id="988805-8" value="&lt;b&gt;main.py + core/lifecycle.py&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;[Component: asyncio]&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Ordered startup and shutdown&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="70" y="150" width="200" height="110" as="geometry"/></mxCell><mxCell id="988805-9" value="&lt;b&gt;core/config.py&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;[Component: pydantic-settings]&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;All settings and secrets from env; SecretStr&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="290" y="150" width="200" height="110" as="geometry"/></mxCell><mxCell id="988805-10" value="&lt;b&gt;socket/auth.py&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;[Component: HMAC v1]&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;x-signature / timestamp / nonce; re-signed on every reconnect&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="510" y="150" width="230" height="110" as="geometry"/></mxCell><mxCell id="988805-11" value="&lt;b&gt;socket/client.py: SocketClient&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;[Component: python-socketio AsyncClient]&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Connect / reconnect, heartbeat pong, emit() → bool (True = delivered)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="760" y="150" width="290" height="110" as="geometry"/></mxCell><mxCell id="988805-12" value="&lt;b&gt;socket/events.py: SocketEventHandler&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;[Component: composition root]&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;handle(): log context (request_id), model selection, run scope (workspace, epoch), _StopFencedSocket&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1070" y="150" width="350" height="110" as="geometry"/></mxCell><mxCell id="988805-13" value="&lt;b&gt;socket/schemas.py, backend_events.py&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;[Component: pydantic]&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Inbound / outbound payload models&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1440" y="150" width="220" height="110" as="geometry"/></mxCell><mxCell id="988805-14" value="&lt;b&gt;socket/event_utils.py&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;[Component: pure helpers]&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Constants, figure / proper-noun checks&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1680" y="150" width="220" height="110" as="geometry"/></mxCell><mxCell id="988805-15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="988805-11" target="988805-10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="988805-16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="988805-11" target="988805-12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="988805-17" value="&lt;b&gt;Workspace lifecycle&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;[Component: workspace_events · documents · extraction · state_roles]&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;workspace_created / sync / updated / version_restore / transferred; batch ingestion; role init; feature-suite order&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="70" y="340" width="280" height="190" as="geometry"/></mxCell><mxCell id="988805-18" value="&lt;b&gt;Panel generators&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;[Component: workspace_metadata · strategy · analysis_report · list_of_dates · applicable_laws · law_relevance · procedural_timeline · relevant_parties · case_laws]&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Long work in tracked background tasks; one payload cache per feature; replay on reconnect&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="370" y="340" width="330" height="190" as="geometry"/></mxCell><mxCell id="988805-19" value="&lt;b&gt;Chat and drafting&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;[Component: chat · drafting · suggestion_chips · user_facts · objective_change · panel_edits]&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Chat, probing prompts, fact corrections, objective-change cascade, panel edits (gated by mutations_allowed)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="720" y="340" width="260" height="190" as="geometry"/></mxCell><mxCell id="988805-20" value="&lt;b&gt;Run control and recovery&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;[Component: run_control · document_reload]&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Stop = fence (epoch bump, cancel, drop buffers); resume re-emits exactly the declared features; single-document re-read&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1000" y="340" width="260" height="190" as="geometry"/></mxCell><mxCell id="988805-21" value="&lt;b&gt;Compliance erasure&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;[Component: workspace_purge]&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Absolute purgeAfter, revoked by live traffic, retry with backoff, CRITICAL + audit on failure&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1280" y="340" width="260" height="190" as="geometry"/></mxCell><mxCell id="988805-22" value="&lt;b&gt;_shared.py: emit chokepoint&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;[Component: _emit_document_feature]&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Panel citations (rag/attribution), law register status, usage metadata; buffers undelivered payloads; _release_refresh_loaders; emits through SocketClient&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1560" y="340" width="340" height="190" as="geometry"/></mxCell><mxCell id="988805-23" value="Dispatches each event&lt;br&gt;to its mixin" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="988805-12" target="988805-18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1245" y="290"/><mxPoint x="667" y="290"/></Array></mxGeometry></mxCell><mxCell id="988805-24" value="&lt;b&gt;Role agent (root gate)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;[Component: langgraph/role_agent.py, state.py, integration.py]&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;ADJUDICATOR / PETITIONER / RESPONDENT / MEDIATOR. No validated role, no downstream agent&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="70" y="610" width="250" height="170" as="geometry"/></mxCell><mxCell id="988805-25" value="&lt;b&gt;Panel agents&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;[Component: list_of_dates_agent, procedural_timeline_agent, nodes]&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Per-document extraction with provenance, consolidation and validation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="340" y="610" width="300" height="170" as="geometry"/></mxCell><mxCell id="988805-26" value="&lt;b&gt;Intelligence chat graph&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;[Component: intelligence_chat_agent, chat_nodes, chat_models]&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;context_builder → intent_classifier → explain_why → action_dispatcher → response_formatter → governance_validator&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="660" y="610" width="280" height="170" as="geometry"/></mxCell><mxCell id="988805-27" value="&lt;b&gt;Drafting&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;[Component: drafting_agent, template_match_graph, template_store, output_filters]&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Template match → gather → understand → decide; DOCX output&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#85BBF0;strokeColor=#5D82A8;fontColor=#000000;" vertex="1" parent="1"><m