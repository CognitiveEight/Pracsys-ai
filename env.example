# Application Configuration
APP_NAME=simplertoday
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Socket.IO Configuration (Backend Specification)
SOCKET_URL=http://localhost:3000
SOCKET_PATH=/socket.io
SOCKET_NAMESPACE=/
SOCKET_RECONNECTION=true
SOCKET_RECONNECTION_ATTEMPTS=0  # 0 = infinite reconnection attempts
SOCKET_RECONNECTION_DELAY=0     # 0 = immediate reconnection (milliseconds)

# Socket.IO Authentication (AI_Maverick Client)
# Get these values from your backend team
SOCKET_SECRET_KEY=your_socket_secret_key_here
SOCKET_AI_PAYLOAD={"_id":"your_ai_user_id","full_name":"AI User","email":"ai@bns.com","isDeleted":false}

# Socket.IO Events (Per Backend Specification)
# AI listens to: workspace_created, workspace_sync, user_message_request, ai_heartbeat_ping
# AI emits: ai_response, ai_heartbeat_pong
# Heartbeat: backend should emit ai_heartbeat_ping on an interval (and optionally from healthCheck)
# so the AI socket stays active; AI replies with ai_heartbeat_pong.
# Signature encoding: URL-safe base64
SOCKET_SIGNATURE_ENCODING=urlsafe

# API Keys - Google Services
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Cost tracking rate overrides (all optional — leave unset to use the built-in
# defaults in app/ai/pricing.py, verified against Google's pricing pages in
# July 2026). Set these to correct a rate when upstream pricing changes, without
# a code deploy. Free tiers and volume discounts are monthly + account-wide and
# are NOT modelled — reported cost is an upper bound on the true invoice.
# LLM tokens: both must be set together to override the per-model table.
# TOKEN_PRICE_INPUT_PER_MILLION=0.30
# TOKEN_PRICE_OUTPUT_PER_MILLION=2.50
# Paid non-LLM APIs:
# OCR_PRICE_PER_1K_UNITS=1.50              # Vision text_detection (1 unit per image AND per PDF page)
# STT_PRICE_PER_MINUTE=0.016               # Speech-to-Text V2 / Chirp 3 (real-time and batch)
# SEARCH_PRICE_PER_1K_QUERIES=1.50         # Vertex AI Search, Standard Edition
# GROUNDING_PRICE_PER_1K_REQUESTS=35.00    # Google Search grounding; default is
#                                          # model-aware (35.00 on Gemini 2.5,
#                                          # 14.00 on Gemini 3) — setting this
#                                          # pins one rate for all models.
# EMBED_PRICE_PER_MILLION_TOKENS=0.15      # Gemini embeddings

# Vector Store (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=simplertoday

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Workspace Configuration
WORKSPACE_DATA_DIR=./data/workspaces
MAX_FILE_SIZE_MB=100

# Feature flags
# Fan a chat fact correction ("the disputed amount is 6 lakh, not 16 lakh") out
# across every panel and pin it so later regenerations cannot revert it.
ENABLE_FACT_CORRECTION_FANOUT=true

# Observability
ENABLE_AUDIT_LOG=true
ENABLE_TRACE=true
PROMETHEUS_PORT=9090


# GCP Vision API for OCR
GOOGLE_APPLICATION_CREDENTIALS=creds_of_google_appliction
GCP_PROJECT_ID=gcp_project_id

# Separate service-account for Speech-to-Text V2 (Chirp 3) + the audio GCS
# bucket. The Vision/OCR SA above does NOT have Speech API permissions.
# Path is relative to cwd or the repo root, or absolute. Falls back to
# GOOGLE_APPLICATION_CREDENTIALS only if that SA also has Speech access.
SPEECH_GOOGLE_APPLICATION_CREDENTIALS=bns-ai-chirp-service.json

# Vertex AI Search (replaces the deprecated Google Custom Search / CSE flow).
# Used as the Indian Kanoon fallback for applicable_laws / law_relevance.
# Create a Website data store in the Vertex AI Search console pointing at
# indiankanoon.org/* (Basic indexing — no domain ownership required), then
# paste its ID below. GCP_PROJECT_ID above is reused for the project field.
VERTEX_SEARCH_DATA_STORE_ID=
VERTEX_SEARCH_LOCATION_ID=global
# 0=unstructured, 1=structured, 2=website, 3=blended
VERTEX_SEARCH_ENGINE_DATA_TYPE=2
VERTEX_SEARCH_MAX_DOCUMENTS=8

# Audio transcription (Chirp 3 / Speech-to-Text V2)
# Required for native Chirp 3 speaker diarization via BatchRecognize.
# Without GCS_BUCKET_NAME, transcription still works but speaker tags may be absent.
GCS_BUCKET_NAME=

# Drafting Assistant — bucket for generated draft .docx files (public-read)
# and retained template skeletons (private). Kept separate from
# GCS_BUCKET_NAME so the two pipelines can have independent IAM / lifecycle
# policies. Use different buckets per environment (e.g. sarthi-stag-bucket
# for staging, sarthi-prod-bucket for production).
GCS_DOCX_BUCKET_NAME=
CHIRP_REGION=us
AUDIO_LANGUAGES=en-IN,hi-IN
AUDIO_MIN_SPEAKERS=2
AUDIO_MAX_SPEAKERS=6
# Optional: pyannote-based voice diarization fallback. Requires `pip install pyannote.audio torch`.
HUGGINGFACE_TOKEN=
PYANNOTE_MODEL=pyannote/speaker-diarization-3.1