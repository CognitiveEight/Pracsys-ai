# Application Configuration
APP_NAME=simplertoday
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Socket.IO Configuration
SOCKET_URL=http://localhost:3000
SOCKET_PATH=/socket.io
SOCKET_NAMESPACE=/
SOCKET_RECONNECTION=true
SOCKET_RECONNECTION_ATTEMPTS=5
SOCKET_RECONNECTION_DELAY=1000

# API Keys - Google Services
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Vector Store (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=simplertoday

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Workspace Configuration
WORKSPACE_DATA_DIR=./data/workspaces
MAX_FILE_SIZE_MB=100

# Observability
ENABLE_AUDIT_LOG=true
ENABLE_TRACE=true
PROMETHEUS_PORT=9090


# GCP Vision API for OCR
GOOGLE_APPLICATION_CREDENTIALS=creds_of_google_appliction
GCP_PROJECT_ID=gcp_project_id

GOOGLE_CSE_ID = google_cse_id