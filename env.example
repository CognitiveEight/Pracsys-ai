# Application Configuration
APP_NAME=simplertoday
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Socket.IO Configuration (Backend Specification)
SOCKET_URL=http://localhost:3000
SOCKET_PATH=/socket.io
SOCKET_NAMESPACE=/
SOCKET_RECONNECTION=true
SOCKET_RECONNECTION_ATTEMPTS=0  # 0 = infinite reconnection attempts
SOCKET_RECONNECTION_DELAY=0     # 0 = immediate reconnection (milliseconds)

# Socket.IO Authentication (AI_Maverick Client)
# Get these values from your backend team
SOCKET_SECRET_KEY=your_socket_secret_key_here
# SOCKET_AI_PAYLOAD is only used by the legacy signature scheme (see below).
SOCKET_AI_PAYLOAD={"_id":"your_ai_user_id","full_name":"AI User","email":"ai@bns.com","isDeleted":false}

# Handshake signature scheme - see docs/AI_SERVICE_AUTH_MIGRATION.md
#   v1     = replay-resistant. Signs "v1:AI_Maverick:<unix_seconds>:<32_hex_nonce>"
#            and sends x-signature / x-signature-timestamp / x-signature-nonce.
#            Requires the host clock to be NTP-synced within +/-300s.
#   legacy = pre-migration constant signature. Replayable forever - rollback only,
#            and only while the backend has AI_SIGNATURE_ALLOW_LEGACY=true.
SOCKET_AUTH_SCHEME=v1

# Engine.IO transports for the handshake, comma-separated. Leave unset for the
# library default (polling, then upgrade to websocket). Set to "websocket" if the
# backend also verifies the nonce on the websocket upgrade request, which would
# otherwise present the same nonce twice and be refused as replayed_nonce.
# SOCKET_TRANSPORTS=websocket

# Socket.IO Events (Per Backend Specification)
# AI listens to: workspace_created, workspace_sync, user_message_request, ai_heartbeat_ping
# AI emits: ai_response, ai_heartbeat_pong
# Heartbeat: backend should emit ai_heartbeat_ping on an interval (and optionally from healthCheck)
# so the AI socket stays active; AI replies with ai_heartbeat_pong.
# Signature encoding: URL-safe base64
SOCKET_SIGNATURE_ENCODING=urlsafe

# API Keys - Google Services
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-3.8-flash
# Embedding model + explicit output size for the vector store. Changing either
# value is a new vector space: re-index before serving from it.
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
# Hard ceiling on one Gemini generation, in seconds. A stalled request would
# otherwise block its caller forever (the long feature generations are awaited
# inline by socket handlers). The strategy/objective regeneration legitimately
# takes ~2 minutes, so keep this comfortably above that. 0 disables the bound.
# Applies to every provider, not just Gemini.
GEMINI_REQUEST_TIMEOUT_SECONDS=300
# Stuck-loader bounds on the per-workspace pipeline lock, in seconds.
# Template-library wait (an undelivered request returns at once), and how long
# drafting waits on it while holding the lock.
TEMPLATE_SYNC_TIMEOUT_SECONDS=900
TEMPLATE_SYNC_IN_LOCK_WAIT_SECONDS=5
# Hard cap on one pipeline run's lock hold; extended by audio duration × factor,
# up to the audio maximum (also used when a duration is unknown).
PIPELINE_RUN_TIMEOUT_SECONDS=900
AUDIO_TIMEOUT_FACTOR=1.0
PIPELINE_RUN_TIMEOUT_AUDIO_MAX_SECONDS=3600
# Informational warning when a case's pipeline lock is held this long.
PIPELINE_LOCK_WARN_SECONDS=300

# ── Model portability (docs/MODEL_PORTABILITY.md) ─────────────────────────────
# All optional. Unset = every call goes to gemini:$GEMINI_MODEL, as before.
# Profile syntax: <provider>:<model>, or openai_compat:<account>:<model>.
# Providers: gemini | openai | azure_openai | azure_foundry | bedrock | sagemaker | openai_compat
# LLM_DEFAULT=gemini:gemini-3.8-flash
# Per-task routes; a task key is the feature= value on the llm_call log line.
# LLM_ROUTES={"explain_why_node":["azure_openai:gpt-4.1"],"audio_transliteration":["openai_compat:qwen:qwen-plus"]}
# Tried after a task's own chain on error/timeout (never after a content block):
# LLM_FALLBACKS=["gemini:gemini-3.8-flash"]
# Models the lawyer may pick per case (aiModel on workspace / chat events):
# {"<id the frontend sends>": "<profile>"}. Unknown ids are ignored.
# LLM_SELECTABLE_MODELS={"gemini-3.8-flash":"gate0:gemini-3.8-flash","gpt-4o":"gate0:gpt-4o"}
# Profiles allowed to serve Google-Search-grounded calls (Gemini only):
# LLM_GROUNDING_PROFILES=["gemini:gemini-3.8-flash"]
# LLM_TRANSIENT_RETRIES=1
# Output ceilings / capabilities the adapters cannot know (a request above the
# ceiling is a hard 400 on most providers):
# LLM_MODEL_OPTIONS={"deepseek-chat":{"max_output_tokens":8192},"meta.llama3-3-70b-instruct-v1:0":{"max_output_tokens":8192}}
# USD per 1M tokens [input, output] for every non-Gemini model you route to.
# Take the rates from the provider's price page; unpriced models fall back to a
# default rate with a warning.
# LLM_PRICING_OVERRIDES={"gpt-4.1":[0.0,0.0]}

# OpenAI
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# Azure OpenAI — omit the key to use Entra ID (managed identity / az login).
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_DEPLOYMENTS={"gpt-4.1":"<deployment-name>"}
# Azure AI Foundry (OpenAI-compatible v1 endpoint) — omit the key for Entra ID.
# AZURE_FOUNDRY_ENDPOINT=https://<resource>.services.ai.azure.com/openai/v1
# AZURE_FOUNDRY_API_KEY=
# AWS Bedrock / SageMaker — credentials ONLY from the AWS chain (role, profile, env).
# AWS_REGION=ap-south-1
# BEDROCK_REGION=
# BEDROCK_GUARDRAIL_ID=
# BEDROCK_GUARDRAIL_VERSION=
# SAGEMAKER_ENDPOINTS={"qwen-72b":{"endpoint":"<endpoint-name>","payload_format":"openai_messages","max_output_tokens":4096}}
# Open-source / OpenAI-compatible servers. Keys are read from the env var named
# in api_key_env (never put a key in this JSON). Local vLLM/Ollama need no key.
# OPENAI_COMPAT_PROFILES={"deepseek":{"base_url":"https://api.deepseek.com","api_key_env":"DEEPSEEK_API_KEY","max_output_tokens":8192},"qwen":{"base_url":"https://dashscope-intl.aliyuncs.com/compatible-mode/v1","api_key_env":"DASHSCOPE_API_KEY"},"local":{"base_url":"http://localhost:8000/v1","supports_images":false}}
# DEEPSEEK_API_KEY=
# DASHSCOPE_API_KEY=
# Gate0 — governed AI gateway (LiteLLM proxy). Route with gate0:<model>.
# GATE0_BASE_URL=https://<gate0-host>/v1
# GATE0_API_KEY=
# GATE0_ENFORCE=true makes gate0 the ONLY path: startup refuses any direct profile.
# GATE0_ENFORCE=false
# GATE0_TAG_REQUESTS=true
# GATE0_APP_NAME=simplertoday
# GATE0_GEMINI_BLOCK_NONE=true
# Any model gate0 serves (Claude, GPT, Azure, or open-source Llama/Qwen/DeepSeek/Mistral)
# is described in LLM_MODEL_OPTIONS, never by its name. Keys per model:
#   max_output_tokens, supports_documents, supports_images,
#   thinking (true -> reasoning_effort), grounding (true -> web_search_options),
#   extra_body (backend-specific params, passed through),
#   family ("anthropic" for Claude's thinking rules; "gemini" for a gate0 group
#           whose name hides a Gemini backend), cohere_input_type (embeddings).
# Example:
# LLM_MODEL_OPTIONS={"claude-sonnet":{"family":"anthropic","thinking":true,"max_output_tokens":32000,"supports_documents":true},
#                    "qwen3-32b":{"max_output_tokens":8192,"extra_body":{"chat_template_kwargs":{"enable_thinking":false}}}}
# Gate0 usage meter: report OCR / Speech-to-Text / search units to gate0 so it holds
# the whole bill. Needs gate0's usage-record endpoint (schema 1.1.0); keep false until then.
# GATE0_METER_ENABLED=false
# GATE0_METER_PATH=/usage-records
# GATE0_METER_FLUSH_SECONDS=10
# GATE0_METER_OUTBOX_DIR=data/gate0_meter_outbox
# Example — everything through gate0:
# LLM_DEFAULT=gate0:gemini-3.8-flash
# LLM_FALLBACKS=["gate0:gpt-4.1"]
# EMBEDDING_PROVIDER=gate0         # gate0 group gemini-embedding-001 at 768 = same vectors, no re-index
# Embeddings: gemini | openai | azure_openai | azure_foundry | bedrock | gate0 | openai_compat:<account>
# A new provider/model/dimension is a new vector space with its own collection:
# run scripts/reindex_chunks.py --from-collection <old> before serving from it.
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_QUERY_PREFIX=

# Cost tracking rate overrides (all optional — leave unset to use the built-in
# defaults in app/ai/pricing.py, verified against Google's pricing pages in
# July 2026). Set these to correct a rate when upstream pricing changes, without
# a code deploy. Free tiers and volume discounts are monthly + account-wide and
# are NOT modelled — reported cost is an upper bound on the true invoice.
# LLM tokens: both must be set together to override the per-model table.
# TOKEN_PRICE_INPUT_PER_MILLION=0.30
# TOKEN_PRICE_OUTPUT_PER_MILLION=2.50
# Paid non-LLM APIs:
# OCR_PRICE_PER_1K_UNITS=1.50              # Vision text_detection (1 unit per image AND per PDF page)
# STT_PRICE_PER_MINUTE=0.016               # Speech-to-Text V2 / Chirp 3 (real-time and batch)
# SEARCH_PRICE_PER_1K_QUERIES=1.50         # Vertex AI Search, Standard Edition
# GROUNDING_PRICE_PER_1K_REQUESTS=35.00    # Google Search grounding; default is
#                                          # model-aware (35.00 on Gemini 2.5,
#                                          # 14.00 on Gemini 3) — setting this
#                                          # pins one rate for all models.
# EMBED_PRICE_PER_MILLION_TOKENS=0.15      # Gemini embeddings

# Vector Store (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=simplertoday
# Optional. Spreadsheet rows for exact calculations (default <name>_tables_v1).
# QDRANT_TABLES_COLLECTION=
# Spreadsheet calculations in chat ([T#] results). Default true.
# TABLE_QUERY_ENABLED=true

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Workspace Configuration
WORKSPACE_DATA_DIR=./data/workspaces
MAX_FILE_SIZE_MB=100

# Feature flags
# Fan a chat fact correction ("the disputed amount is 6 lakh, not 16 lakh") out
# across every panel and pin it so later regenerations cannot revert it.
ENABLE_FACT_CORRECTION_FANOUT=true

# Observability
ENABLE_AUDIT_LOG=true
ENABLE_TRACE=true
PROMETHEUS_PORT=9090


# GCP Vision API for OCR
GOOGLE_APPLICATION_CREDENTIALS=creds_of_google_appliction
GCP_PROJECT_ID=gcp_project_id

# Separate service-account for Speech-to-Text V2 (Chirp 3) + the audio GCS
# bucket. The Vision/OCR SA above does NOT have Speech API permissions.
# Path is relative to cwd or the repo root, or absolute. Falls back to
# GOOGLE_APPLICATION_CREDENTIALS only if that SA also has Speech access.
SPEECH_GOOGLE_APPLICATION_CREDENTIALS=bns-ai-chirp-service.json

# Vertex AI Search (replaces the deprecated Google Custom Search / CSE flow).
# Used as the Indian Kanoon fallback for applicable_laws / law_relevance.
# Create a Website data store in the Vertex AI Search console pointing at
# indiankanoon.org/* (Basic indexing — no domain ownership required), then
# paste its ID below. GCP_PROJECT_ID above is reused for the project field.
VERTEX_SEARCH_DATA_STORE_ID=
VERTEX_SEARCH_LOCATION_ID=global
# 0=unstructured, 1=structured, 2=website, 3=blended
VERTEX_SEARCH_ENGINE_DATA_TYPE=2
VERTEX_SEARCH_MAX_DOCUMENTS=8

# Audio transcription (Chirp 3 / Speech-to-Text V2)
# Required for native Chirp 3 speaker diarization via BatchRecognize.
# Without GCS_BUCKET_NAME, transcription still works but speaker tags may be absent.
GCS_BUCKET_NAME=

# Drafting Assistant — bucket for generated draft .docx files (public-read)
# and retained template skeletons (private). Kept separate from
# GCS_BUCKET_NAME so the two pipelines can have independent IAM / lifecycle
# policies. Use different buckets per environment (e.g. sarthi-stag-bucket
# for staging, sarthi-prod-bucket for production).
GCS_DOCX_BUCKET_NAME=
CHIRP_REGION=us
AUDIO_LANGUAGES=en-IN,hi-IN
AUDIO_MIN_SPEAKERS=2
AUDIO_MAX_SPEAKERS=6
# Recordings over 20 min (the Chirp 3 BatchRecognize limit) are cut into
# overlapping windows, transcribed in parallel and stitched together.
AUDIO_BATCH_WINDOW_SECONDS=1140
AUDIO_WINDOW_OVERLAP_SECONDS=15
AUDIO_BATCH_CONCURRENCY=4
# Longer recordings are rejected before any paid call. 0 = no cap.
AUDIO_MAX_DURATION_MINUTES=1440
# Optional: pyannote-based voice diarization fallback. Requires `pip install pyannote.audio torch`.
HUGGINGFACE_TOKEN=
PYANNOTE_MODEL=pyannote/speaker-diarization-3.1
# Legal knowledge graph (ontology agentic RAG). Leave NEO4J_URL unset to run
# without a graph — retrieval then uses hybrid search alone.
# NEO4J_URL=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=change-me
# NEO4J_EDITION=community
# Extract ontology facts after ingestion (one LLM call per chunk; off by default)
ONTOLOGY_INGEST_ENABLED=false
# Panels using graph + hybrid retrieval, comma-separated. Enable a panel only
# after scripts/eval_rag.py shows it beats the baseline.
RETRIEVAL_PANELS=
RETRIEVAL_MODE=augment
